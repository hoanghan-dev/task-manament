# =============================================================================
# Integration Test Environment Variables
# =============================================================================
# Copy this file or set these env vars before running integration tests.
# IMPORTANT: Use a separate test database, NOT your dev/production database.
# =============================================================================

# PostgreSQL Test Database
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=123456
TEST_DB_NAME=task_management_test
TEST_DB_SSLMODE=disable

# JWT Secret (test-only, never use in production)
SECRET_KEY=integration-test-secret-key-do-not-use-in-prod

# Redis (use DB=1 to separate from dev DB=0)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=1
