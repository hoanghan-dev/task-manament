{
  "name": "task-manament",
  "version": "0.1.0",
  "description": "A modern task management application",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist build coverage .nyc_output",
    "prepare": "husky install 2>/dev/null || true"
  },
  "keywords": [
    "task",
    "management",
    "productivity",
    "todo"
  ],
  "author": "hoanghan-dev",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "commitlint": "^17.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
